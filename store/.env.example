# Copia este archivo como .env y completa los valores reales.
# El .env NO se sube a git (esta en .gitignore). Cada maquina tiene el suyo.

# --- Django ---
DJANGO_SECRET_KEY=pone-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Desarrollo (Mac): DB_ENGINE=sqlite (usa db.sqlite3, no hace falta lo demas)
# Produccion (VPS): DB_ENGINE=postgresql y completar el resto
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email (opcional) ---
EMAIL_HOST=smtp.yourmailserver.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
